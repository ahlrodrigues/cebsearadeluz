# Copy to .env and set real values. Never commit secrets.

# Security
SECRET_KEY=change-me-strong-random
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS for local diagnostics; in staging you usually won’t need it when using same-site domains
CORS_ORIGINS=

# SMTP (optional but recommended if enabling email confirmations)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=no-reply@example.com
SMTP_STARTTLS=1

# App behavior
FRONTEND_BASE_URL=https://staging.example.com
CONFIRM_EMAIL_ON_REGISTER=1
PROTECT_USER_ADMIN_ROUTES=1
PROTECT_EXAM_ROUTES=1
PROTECT_PUBLIC_SCAN=1
ALLOW_LEGACY_QR=0
REQUIRE_REGISTRATION_APPROVAL=0

# Database
# Default uses a Docker volume with SQLite; for Postgres set something like:
# DATABASE_URL=postgresql+psycopg://user:pass@dbhost:5432/dbname
DATABASE_URL=sqlite:////data/app.db

